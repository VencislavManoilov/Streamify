DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
JWT_SECRET=
OMDB_API_KEY=
TMDB_API_KEY=
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_TLS_REJECT_UNAUTHORIZED=
EMAIL_USER=
EMAIL_PASS=
FRONTEND_URL=
CORS_ORIGIN=["", "", ...]
OPENSUBS_API_KEY=
OPENSUBS_USERNAME=
OPENSUBS_PASSWORD=

# Optional
# YTS moves domains every now and then, change this when the API moves again
YTS_API_URL=https://movies-api.accel.li/api/v2
# Where torrents are downloaded while they are streamed (cleared on start)
TORRENT_DOWNLOAD_PATH=
# Minutes a torrent nobody watches is kept before it and its data are removed
TORRENT_IDLE_MINUTES=10
# Torrents that can be loaded at the same time (torrents being watched are never removed)
TORRENT_MAX_ACTIVE=4
# Peer connections per torrent, higher finds peers faster
TORRENT_MAX_CONNECTIONS=150
# Minutes between the background checks of the mail server shown in the admin panel (0 turns them off).
# The check only logs in to the mail server, it never sends an email.
MAIL_CHECK_MINUTES=10

# Series
# Stremio torrent add-ons that find the torrents of episodes, separated by commas. Torrentio needs no setup.
# Others (MediaFusion, Comet, Jackettio, a self-hosted Torrentio or Knightcrawler...) can be added with the
# address their configuration page gives you; a manifest.json address works as it is.
STREAM_ADDONS=https://torrentio.strem.fun
# Where episodes converted for the browser are kept while they're watched (cleared on start)
HLS_CACHE_PATH=
# Episodes in a video format the browser can't decode (mostly HEVC/x265 in Chrome) are encoded again as
# H.264, which takes a lot of CPU. 0 turns it off; such episodes are then ranked last or left out.
TRANSCODE_VIDEO=1
# Height the encoded video is scaled down to, the x264 preset and quality (lower CRF is better and bigger)
TRANSCODE_MAX_HEIGHT=1080
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=21
# ffmpeg runs that may convert at the same time
HLS_MAX_JOBS=6
# Only when ffmpeg isn't on the PATH
FFMPEG_PATH=
FFPROBE_PATH=
